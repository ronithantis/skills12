                          </div>

                          <div className="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">

                            <div className="h-full bg-slate-900 rounded-full w-0 transition-all duration-500" />

                          </div>

                        </div>

                      ))}

                    </div>

                  </div>

                </div>

              )}

            </div>

 

          </div>

        )}

 

      </main>

 

      {}

      {/* QR Code Projection Modal for Classroom Use */}

      {qrModalCode && (

        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">

          <div className="bg-white rounded-2xl max-w-md w-full p-6 sm:p-8 text-center space-y-5 shadow-2xl border border-slate-200 overflow-y-auto max-h-[90vh]">

           

            <div className="flex justify-between items-center border-b border-slate-100 pb-3">

              <span className="text-xs font-bold text-slate-400 uppercase tracking-widest">מראת ההתארגנות • סריקה לכיתה</span>

              <button

                onClick={() => setQrModalCode(null)}

                className="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold flex items-center justify-center text-sm"

              >

                ✕

              </button>

            </div>

 

            <div className="space-y-1">

              <h3 className="text-xl sm:text-2xl font-bold text-slate-900">סורקים ומגיעים ישר לאבחון</h3>

              <p className="text-xs sm:text-sm text-slate-500">כוון את מצלמת הטלפון לברקוד כדי להיכנס לשאלון הכיתתי</p>

            </div>

 

            {/* Scannable QR Code Image */}

            <div className="p-4 bg-white border-2 border-slate-900 rounded-2xl inline-block shadow-inner">

              <img

                src={`https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=${encodeURIComponent(

                  `${getBaseUrl()}?code=${qrModalCode}`

                )}`}

                alt={`QR Code for ${qrModalCode}`}

                className="w-48 h-48 sm:w-56 sm:h-56 mx-auto rounded-lg"

              />

            </div>

 

            {/* Displayed Class Code */}

            <div className="p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-1">

              <span className="text-xs text-slate-400 font-medium">קוד הכיתה:</span>

              <div className="text-3xl font-mono font-bold tracking-widest text-slate-900">{qrModalCode}</div>

            </div>

 

            {/* Explanatory Notice for Local Preview vs Production */}

            <div className="bg-amber-50 border border-amber-200 p-3.5 rounded-xl text-right text-xs text-amber-900 space-y-1">

              <div className="font-bold flex items-center gap-1">

                <span>💡 כיצד התלמידים ייכנסו בכיתה?</span>

              </div>

              <p className="leading-relaxed">

                <strong>אפשרות 1:</strong> התלמידים נכנסים לאתר האבחון ומקלידים את הקוד <strong className="font-mono">{qrModalCode}</strong>.

              </p>

              <p className="leading-relaxed">

                <strong>אפשרות 2 (סריקה):</strong> סריקת ה-QR תעבוד בנייד ברגע שהמערכת מועלית לכתובת האתר האמיתית שלכם באינטרנט.

              </p>

            </div>

 

            {/* Copy Direct Link & Custom Domain Helper */}

            <div className="space-y-2 text-right pt-1">

              <button

                onClick={() => handleCopyLink(qrModalCode)}

                className="w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-900 font-semibold rounded-lg text-xs transition-colors flex items-center justify-center gap-1.5"

              >

                <span>{copySuccess ? '✓ הקישור הועתק בהצלחה!' : '📋 העתק קישור ישיר לשיתוף ב-WhatsApp / קלאסרום'}</span>

              </button>

 

              <details className="text-xs text-slate-500 pt-1">

                <summary className="cursor-pointer hover:text-slate-800 text-center font-medium">

                  ⚙️ הגדרת כתובת האתר (אם תרצה לשנות את הדומיין)

                </summary>

                <div className="mt-2 space-y-1.5 text-right bg-slate-50 p-3 rounded-lg border border-slate-200">

                  <label className="block text-slate-700 font-medium text-[11px]">כתובת האתר הפעילה:</label>

                  <input

                    type="text"

                    value={customBaseUrl}

                    onChange={(e) => setCustomBaseUrl(e.target.value)}

                    placeholder={getBaseUrl()}

                    className="w-full p-2 bg-white border border-slate-300 rounded text-xs font-mono dir-ltr text-left"

                  />

                  <p className="text-[10px] text-slate-400 leading-tight">

                    תוכל להקליד כאן את כתובת השרת/הדומיין שלך במידה והאפליקציה מאוחסנת בשרת חיצוני.

                  </p>

                </div>

              </details>

            </div>

 

            <button

              onClick={() => setQrModalCode(null)}

              className="w-full py-2.5 bg-slate-900 text-white font-semibold rounded-xl hover:bg-slate-800 transition-colors text-sm"

            >

              סגור חלונית

            </button>

 

          </div>

        </div>

      )}

 

      {/* Footer */}

      <footer className="border-t border-slate-200 bg-white py-6 mt-12">

        <div className="max-w-4xl mx-auto px-6 text-center text-xs text-slate-400 space-y-1">

          <p>מראת ההתארגנות • מערכת אבחון אישית למיומנויות סדר וארגון לתלמידים</p>

          <p>פותח במיוחד עבור תלמידי חטיבת ביניים (כיתות ו'–ח') • ללא ציון וללא שיפוט</p>

        </div>

      </footer>

 

    </div>

  );

}
